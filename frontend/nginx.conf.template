server {
    listen ${PORT};
    root /usr/share/nginx/html;
    server_tokens off;

    # nginx drops inherited add_header lines in any location that sets its own,
    # so the security headers are repeated in each location below.

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # Hashed build assets never change, so they can be cached for a long time.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    # Same-origin API proxy (increment 1.10.3): the SPA calls relative /api
    # URLs, so session and CSRF cookies are first-party. Cross-origin cookies
    # are blocked outright by some browsers (Safari's ITP on iOS), which made
    # login 403 even with correct CORS and SameSite=None. BACKEND_URL is the
    # API's base URL (e.g. https://backend-uat.up.railway.app), substituted
    # into this template by the nginx image at container start.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        # Django's ALLOWED_HOSTS expects the backend's own hostname; the
        # tenant middleware selects /api tenants from the X-Tenant header,
        # not the host, so this loses nothing.
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Railway's edge terminates TLS; pass through the original scheme so
        # Django (SECURE_PROXY_SSL_HEADER) sees https.
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    # Single-page app: unknown paths serve index.html, which is never cached.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }
}

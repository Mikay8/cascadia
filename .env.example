# Environment variable names. Copy to .env for local use and fill in values. Never commit real
# values. Staging and production set these in the hosting platform (see docs/INFRASTRUCTURE.md).

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL
DATABASE_URL=postgres://cascadia:cascadia@localhost:5432/cascadia

# Back-end container (optional)
PORT=8000
WEB_CONCURRENCY=2
RUN_MIGRATIONS=1

# Front-end dev server (optional): where Vite proxies /api
API_PROXY_TARGET=http://localhost:8000
